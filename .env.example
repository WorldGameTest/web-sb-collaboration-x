# Copy to .env.local and fill in. Never commit .env.local.

# --- Google Sheet (the content database) -----------------------------------
# Deployed Apps Script web-app URL. Used BOTH to append submissions and to read
# back approved games. See google-sheets/README.md.
SHEETS_WEBHOOK_URL=

# Long random string. Must match SHARED_SECRET in google-sheets/Code.gs.
# It gates writing submissions, reading the game list, and the status webhook.
SHEETS_SECRET=

# --- Site ------------------------------------------------------------------
# Public URL, no trailing slash. Used in emails and by the sheet's trigger.
SITE_URL=https://bundly.online

# --- Email -----------------------------------------------------------------
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=

# Must be an address on a domain you have verified with your provider.
# A personal Gmail will not work — see the README.
EMAIL_FROM=Bundly <hello@bundly.online>

# Where developer replies land. Can be your normal inbox.
EMAIL_REPLY_TO=hello@bundly.online

# --- Admin -----------------------------------------------------------------
# Separate long random string, guards POST /api/announce (mass email).
ADMIN_SECRET=

# --- Auth ------------------------------------------------------------------
# Signs the passwordless sign-in links. Long random string:
#   openssl rand -base64 32
# Sign-in returns a 500 until this is set. Changing it invalidates every
# outstanding link, which is also how you force everyone to sign in again.
AUTH_SECRET=
